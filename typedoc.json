{
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "theme": "default",
  "name": "Apuntador API Documentation",
  "readme": "none",
  "includeVersion": true,
  "sort": ["source-order"],
  "exclude": ["**/node_modules/**", "**/*.spec.ts", "**/*.test.ts", "**/tests/**"],
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": false,
  "hideGenerator": false,
  "searchInComments": true,
  "cleanOutputDir": true,
  "plugin": ["typedoc-plugin-markdown"],
  "gitRevision": "main",
  "titleLink": "https://github.com/yourusername/apuntador",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  }
}
