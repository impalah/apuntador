{
  "name": "apuntador",
  "private": true,
  "version": "0.1.37",
  "type": "module",
  "description": "Modular teleprompter platform with interchangeable components - built with Vue 3 + TypeScript + Vite + Vuetify",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "stylelint": "stylelint \"src/**/*.{vue,css,scss}\"",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:serve": "npm run docs:build && npm run docs:preview",
    "android:build": "npm run build && npx cap copy android && npx cap sync android",
    "android:dev": "npm run android:build && npx cap open android",
    "android:run": "npm run android:build && npx cap run android",
    "android:icons": "npx capacitor-assets generate",
    "android:apk": "npm run android:build && npx cap open android",
    "android:release": "npm run android:build && cd android && ./gradlew assembleRelease",
    "android:apk:build": "powershell -ExecutionPolicy Bypass -File build-android-apk.ps1",
    "android:apk:build:linux": "./build-android-apk.sh",
    "ios:build": "npm run build && npx cap copy ios && npx cap sync ios",
    "ios:dev": "npm run android:build && npx cap open ios",
    "capacitor:sync": "npx cap sync",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:release": "tauri build --config '{\"bundle\":{\"targets\":\"msi\"}}' --target x86_64-pc-windows-msvc",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "tauri:build:mac-universal": "tauri build --target universal-apple-darwin",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "clean": "rimraf dist coverage test-results playwright-report docs/api docs/.vitepress/dist src-tauri/target",
    "clean:deps": "rimraf node_modules package-lock.json && npm cache clean --force",
    "clean:all": "npm run clean && npm run clean:deps",
    "fresh": "npm run clean:all && npm install"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/screen-orientation": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@mdi/font": "^7.3.0",
    "@tauri-apps/api": "^2.8.0",
    "localforage": "^1.10.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-mark": "^3.0.1",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0",
    "vuetify": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "^1.40.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.0",
    "jsdom": "^23.0.0",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.69.7",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
