{
  "name": "apuntador",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "description": "Mobile-first teleprompter built with Vue 3 + TypeScript + Vite + Vuetify",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "stylelint": "stylelint \"src/**/*.{vue,css,scss}\"",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:serve": "npm run docs:build && npm run docs:preview",
    "clean": "rimraf dist coverage test-results playwright-report docs/api docs/.vitepress/dist",
    "clean:deps": "rimraf node_modules package-lock.json && npm cache clean --force",
    "clean:all": "npm run clean && npm run clean:deps",
    "fresh": "npm run clean:all && npm install"
  },
  "dependencies": {
    "@mdi/font": "^7.3.0",
    "localforage": "^1.10.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-mark": "^3.0.1",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vuetify": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/markdown-it": "^13.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.0",
    "jsdom": "^23.0.0",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.69.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typedoc": "^0.28.10",
    "typedoc-plugin-markdown": "^4.8.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
