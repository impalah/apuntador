# Google Drive API Configuration
# Get your credentials from: https://console.cloud.google.com/apis/credentials

# Cliente Web/Desktop (para desarrollo web y Tauri desktop)
# Tipo: "Aplicación de escritorio" en Google Cloud Console
# Requiere client_secret (menos seguro pero funcional)
VITE_GOOGLE_DRIVE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret

# Cliente Android (opcional, solo para móvil Capacitor)
# Tipo: "Android" en Google Cloud Console
# NO requiere client_secret (más seguro)
# Si no se proporciona, se usará el cliente web también para móvil
# VITE_GOOGLE_DRIVE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# DEPRECATED: Esta variable ya no se usa
# VITE_GOOGLE_OAUTH_CLIENT_TYPE=android

