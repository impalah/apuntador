# ===================================================================
# OAUTH REDIRECT URIs
# ===================================================================
# URLs de redirección para OAuth 2.0
# Estas URLs deben estar registradas en las consolas de:
# - Google Cloud Console: https://console.cloud.google.com/apis/credentials
# - Dropbox App Console: https://www.dropbox.com/developers/apps

# Desarrollo (localhost)
# Se usa durante npm run dev
VITE_OAUTH_REDIRECT_URI_DEV=http://localhost:3000/oauth-callback

# Producción (dominio público)
# Cambia esto por tu dominio real en producción
VITE_OAUTH_REDIRECT_URI_PROD=https://app.apuntador.io/oauth-callback

# Nativo móvil (Custom URL Scheme para Android/iOS)
# Se usa en builds de Android/iOS con Capacitor
VITE_OAUTH_REDIRECT_URI_NATIVE=apuntador://oauth-callback

# Desktop (Tauri - servidor local HTTP)
# Se usa en la versión desktop de Tauri
# IMPORTANTE: Registra esta URL en Dropbox App Console
VITE_OAUTH_REDIRECT_URI_TAURI=http://localhost:8080/oauth/callback


# ===================================================================
# GOOGLE DRIVE API CONFIGURATION
# ===================================================================
# Get your credentials from: https://console.cloud.google.com/apis/credentials

# Cliente Web/Desktop (para desarrollo web y Tauri desktop)
# Tipo: "Aplicación de escritorio" en Google Cloud Console
# Requiere client_secret (menos seguro pero funcional)
VITE_GOOGLE_DRIVE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret

# Cliente Android (opcional, solo para móvil Capacitor)
# Tipo: "Android" en Google Cloud Console
# NO requiere client_secret (más seguro)
# Si no se proporciona, se usará el cliente web también para móvil
# VITE_GOOGLE_DRIVE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com


# ===================================================================
# DROPBOX API CONFIGURATION
# ===================================================================
# Get your App Key from: https://www.dropbox.com/developers/apps
# Create a new app with "Scoped access" type

VITE_DROPBOX_CLIENT_ID=your-dropbox-app-key


# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
# Backend OAuth proxy URLs
# 
# IMPORTANTE: La API está desplegada en producción en api.apuntador.io
# - Usa PROD para desarrollo normal y producción (por defecto)
# - Usa DEV solo para pruebas locales con el backend corriendo en localhost
# - ngrok ya no se usa

# Producción (API desplegada en AWS)
# Usar esta URL para desarrollo normal y builds de producción
VITE_BACKEND_OAUTH_URL_PROD=https://api.apuntador.io

# Desarrollo local (solo si estás corriendo el backend localmente)
# Descomentar y cambiar si estás desarrollando el backend
# VITE_BACKEND_OAUTH_URL_DEV=http://localhost:8000

# Para iOS en desarrollo local (si usas backend local)
# VITE_BACKEND_OAUTH_URL_IOS_DEV=http://YOUR_LOCAL_IP:8000


# ===================================================================
# API ENDPOINTS CONFIGURATION
# ===================================================================
# URLs de APIs externas - NO cambiar a menos que uses servicios alternativos

# Google APIs (por defecto usar URLs oficiales de Google)
VITE_GOOGLE_API_DRIVE_BASE_URL=https://www.googleapis.com/drive/v3
VITE_GOOGLE_API_UPLOAD_BASE_URL=https://www.googleapis.com/upload/drive/v3
VITE_GOOGLE_API_CONTENT_BASE_URL=https://content.googleapis.com

# Dropbox APIs (por defecto usar URLs oficiales de Dropbox)
VITE_DROPBOX_AUTH_URL=https://www.dropbox.com/oauth2/authorize
VITE_DROPBOX_TOKEN_URL=https://api.dropboxapi.com/oauth2/token
VITE_DROPBOX_API_URL=https://api.dropboxapi.com/2
VITE_DROPBOX_CONTENT_URL=https://content.dropboxapi.com/2


# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
# 1. Todas las variables VITE_* son PÚBLICAS y se incluyen en el bundle
# 2. Los valores se inyectan en tiempo de compilación (npm run build)
# 3. Para producción, configura estas variables en tu hosting (Vercel/Netlify)
# 4. Nunca subas el archivo .env al repositorio (está en .gitignore)
# 5. El código usa VITE_BACKEND_OAUTH_URL_PROD por defecto si DEV no está definida
# 6. Más información: docs/ENVIRONMENT_VARIABLES.md


